# Install:
# Follow README.md

# RClone management built-in Web GUI
# rclone rcd --rc-web-gui
# Official docs: https://rclone.org/gui/

# Run as rclone-rcd-gui.service

[Unit]
Description=Rclone RC Web GUI
Documentation=https://rclone.org/rc/
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
EnvironmentFile=%h/.config/rclone-rcd-gui/.config
ExecStart=/usr/bin/rclone rcd --rc-web-gui --rc-addr=${RC_ADDR}:${RC_PORT}
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s

# Security
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=default.target