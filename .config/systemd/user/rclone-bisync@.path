# Rclone Bisync Path Watcher (template unit)
# Triggers sync on local file changes
# Override paths: ~/.config/systemd/user/rclone-bisync@MyRemote.path.d/override.conf

[Unit]
Description=%p path watcher: remote "%i"
Conflicts=%p@%i.timer

[Path]
Unit=%p@%i.service
PathModified=%h/.%p/%i/
PathChanged=%h/.%p/%i/
# Debounce: prevents rapid re-triggering from incoming sync changes
TriggerLimitIntervalSec=30
TriggerLimitBurst=1

[Install]
WantedBy=paths.target
