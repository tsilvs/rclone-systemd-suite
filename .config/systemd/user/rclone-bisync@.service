# Rclone Bisync Service (template unit)
# Usage: systemctl [--user] enable --now rclone-bisync@MyRemote.timer
# %i = remote name (e.g., MyRemote)

[Unit]
Description=%p: remote "%i"
After=network-online.target
Wants=network-online.target

[Service]

# Built-in defaults
Environment=CHECK_FILE=RCLONE_TEST

# Systemd-managed paths (%i = instance name, %h = home, %C = cache, %E = /etc or ~/.config)
Environment=REMOTE=%i:
Environment=CACHE_DIR=%C/%p/%i
Environment=LOCAL_PATH=%h/.%p/%i

# Config precedence: system global -> user global -> system per-remote -> user per-remote
EnvironmentFile=-%E/%p/conf.env
EnvironmentFile=-%h/.config/%p/conf.env
EnvironmentFile=-%E/%p/%iconf.env
EnvironmentFile=-%h/.config/%p/%iconf.env

Type=oneshot

# Health check: rclone installed + remote accessible
ExecCondition=command -v rclone >/dev/null && \
	command -v logger >/dev/null && \
	rclone lsd "$REMOTE" >/dev/null 2>&1

# Bisync logic: init on first run, then routine sync with conflict handling
ExecStart=/bin/bash -ec 'if [ ! -f "$CACHE_DIR/.initialized" ]; then \
		mkdir -p "$LOCAL_PATH" "$CACHE_DIR" && \
		echo "bisync-test-$(date +%%s)" > "$LOCAL_PATH/$CHECK_FILE" && \
		rclone copy "$LOCAL_PATH/$CHECK_FILE" "$REMOTE" --create-empty-src-dirs && \
		rclone bisync "$LOCAL_PATH" "$REMOTE" --resync --create-empty-src-dirs && \
		touch "$CACHE_DIR/.initialized"; \
	else \
		rclone bisync "$LOCAL_PATH" "$REMOTE" \
			--check-access \
			--check-filename "$CHECK_FILE" \
			--resilient \
			--recover \
			--conflict-resolve newer \
			--conflict-loser num \
			--create-empty-src-dirs \
			${BISYNC_FLAGS:+$BISYNC_FLAGS}; \
	fi'

ExecStartPost=logger -t "%N" "Sync completed successfully"

[Install]
WantedBy=default.target
