# Rclone RC Web GUI Configuration
# Place as: ~/.config/rclone-rcd-gui/conf.env
# System-wide: /etc/rclone-rcd-gui/conf.env

# RC_ADDR   Bind address
# RC_PORT   Web GUI port
# RC_FLAGS  Extra flags, including

## RC auth
## WARNING: Change default credentials!
## Current: admin/admin (insecure for non-localhost)
# Examples:
# RC_FLAGS=--rc-user=myuser --rc-pass=strongpass
# RC_FLAGS=--rc-no-auth  # Disable (localhost only)
# RC_FLAGS=--rc-user=admin --rc-pass=admin --log-level=DEBUG

# IMPORTANT: KEEP VARS AT THE END OF THE FILE TO NOT CONFUSE SYSTEMD BASH!!

RC_ADDR="127.0.0.1"
RC_PORT="5572"
RC_FLAGS="--rc-user admin --rc-pass admin"

