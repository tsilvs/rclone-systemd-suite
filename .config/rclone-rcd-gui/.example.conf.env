# Rclone RC Web GUI Configuration
# Place as: ~/.config/rclone-rcd-gui/conf.env
# System-wide: /etc/rclone-rcd-gui/conf.env

# RC_PORT=5572        # Web GUI port
# RC_ADDR=127.0.0.1   # Bind address

# RC authentication (required unless RC_NO_AUTH=1)
# RC_USER=admin       # Username
# RC_PASS=changeme    # Password
# RC_NO_AUTH=1        # Disable auth (insecure, local use only)
