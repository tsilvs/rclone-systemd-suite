# Rclone Bisync Configuration
# Place as: ~/.config/rclone-bisync/.config (global) or ~/.config/rclone-bisync/MyRemote.config (per-remote)
# System-wide: /etc/rclone-bisync/.config or /etc/rclone-bisync/MyRemote.config

# SYNC_ROOT=~/.rclone-bisync           # Base directory for local sync paths
# BISYNC_FLAGS=                         # Additional rclone bisync flags
# CHECK_FILE=RCLONE_TEST               # Bisync health check filename
# LOCAL_PATH=~/.rclone-bisync/MyRemote # Local path for this remote (auto-derived from SYNC_ROOT if unset)
# CACHE_DIR=                            # Bisync cache directory (auto-managed by systemd)
